# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-only-server

# Drizzle — copy จาก Supabase Dashboard → Settings → Database → Connection string
#   → แท็บ "Session pooler"  (port 5432)
# Session pooler รองรับ prepared statements จึงใช้ได้ทั้งกับ drizzle-kit และ runtime
# (Transaction pooler 6543 ไม่รองรับ prepared statement — ใช้ได้ แต่เจอปัญหากับ migrate)
# ถ้ารหัสผ่านมีอักขระ $ ต้องเขียนเป็น %24 และครอบด้วยเครื่องหมายคำพูด
#   DATABASE_URL="postgresql://...:Mougaw%24_3191@..."
# ไม่งั้น Next บน Windows จะมอง $_3191 เป็นตัวแปรแล้วตัดรหัสผ่านทิ้งจนเข้า DB ไม่ได้
DATABASE_URL=postgresql://postgres.XXXXXXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# ถ้าคุณมีแอปที่ต้องการ connection ตรง (เช่น Neon/Supabase direct)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.XXXXXXXX.supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────────
# AI providers (admin-managed — ผู้ใช้ทั่วไปใส่ key เองไม่ได้)
# ─────────────────────────────────────────────────────────────
TOKENHARBOR_API_KEY=
OKMD_API_KEY=

# ─────────────────────────────────────────────────────────────
# SlipOK — ตรวจสลีป PromptPay
# ⚠️ ROTATE KEY เดิมก่อนใช้งาน ค่าเดิมถูกเปิดเผยในแชทแล้ว
# ─────────────────────────────────────────────────────────────
SLIPOK_BRANCH_ID=78152
SLIPOK_API_KEY=
SLIPOK_LOG_MODE=true

# ─────────────────────────────────────────────────────────────
# Web search tool (เลือกอันเดียวที่ใช้)
# ─────────────────────────────────────────────────────────────
TAVILY_API_KEY=
# EXA_API_KEY=

# ─────────────────────────────────────────────────────────────
# Synthetic email domain for username/password accounts.
#
# A username maps to a fake address `bob@<domain>` so Supabase Auth (which only
# understands emails) can store the password. The address can never receive
# mail, so email confirmation MUST be off — see README.
#
# Use a subdomain of a domain you actually control. Supabase runs DNS checks
# on the domain, and a name that does not resolve can fail validation with
# `email_address_invalid`.
# ─────────────────────────────────────────────────────────────
SYNTHETIC_EMAIL_DOMAIN=users.aichat.app

# ─────────────────────────────────────────────────────────────
# Google OAuth (ทางเลือก — ไม่ใช้ก็เว้นว่างไว้ได้)
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# แล้วกรอกค่าเดียวกันที่ Supabase → Authentication → Sign In / Providers → Google
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# username ที่จะยกให้เป็น admin ตอน seed (คั่นด้วย comma)
ADMIN_USERNAMES=

# Cron endpoints (Vercel injects this as an Authorization header on scheduled hits)
CRON_SECRET=